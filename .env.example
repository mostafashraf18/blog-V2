# Copy this file to .env for local development. Hosting providers let you set these in their dashboard instead.

# Port the server listens on. Most hosts set this for you.
PORT=3000

# development or production
NODE_ENV=development

# Number of proxies in front of the app (1 on Render, Railway, Heroku, Fly). Defaults to 1 in production.
# TRUST_PROXY=1

# Where contact-form messages are saved. Point this at a persistent disk in production.
# DATA_DIR=./data

# Optional. Enables GET /api/messages with "Authorization: Bearer <token>". Use at least 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=
